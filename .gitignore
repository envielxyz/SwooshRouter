# Swoosh Router root ignore
node_modules/
.claude/

# Build artifacts
tsconfig.tsbuildinfo
dist-binary/

# Dashboard SPA build output
dashboard/dist/
dashboard/node_modules/
dashboard/.vite/
playwright-report/
test-results/

# Public demos are attached to GitHub Releases, not stored in Git history
docs/media/video/*.mp4
!docs/media/video/.gitkeep

# Local secrets / debug scratch (never commit)
.env
.env.*
!.env.example
.swooshrouter/
data/
backups/
*.sqlite
*.sqlite-wal
*.sqlite-shm
server.log
server-*.log
.tmp-build-*
.tmp-image-build/
.tmp-warp-build/
